# Nujek Merchant Open API v1 — contoh konfigurasi (Svelte sample)
# Salin file ini menjadi `.env` lalu isi dengan kredensialmu:
#   cp .env.example .env
# File `.env` JANGAN di-commit (sudah ada di .gitignore).
#
# Nilai dari .env dipakai sebagai nilai awal form di aplikasi.
# Begitu kamu mengubah form di browser, nilai tersimpan di localStorage
# dan mengalahkan .env. Hapus localStorage (atau isi ulang form) bila
# ingin kembali memakai nilai .env.

# Base URL API — staging atau produksi
VITE_API_BASE_URL=https://staging-merchant-api.nujek.co.id

# API key (dibuat di aplikasi: Pengaturan -> Developer)
VITE_API_KEY=nk_live_...

# Secret (43 karakter base64url, hanya ditampilkan sekali saat dibuat)
# Dipakai HANYA untuk menghitung signature HMAC di browser, tidak dikirim.
VITE_API_SECRET=

# ID toko yang terikat key di atas
VITE_STORE_ID=store_...
